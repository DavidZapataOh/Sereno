    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.5.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run verify:servidor",
    "verify:servidor": "npm --prefix servidor run verify",
    "verificar-volcado": "node scripts/verificar-volcado.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "verificar-ledger": "tsx scripts/verificar-ledger.ts",
    "cobertura-comercios": "tsx scripts/cobertura-comercios.ts",
    "integrar": "bash scripts/integrar.sh",
    "comprobar-node": "node scripts/comprobar-node.mjs",
    "pretest": "node scripts/comprobar-node.mjs",
    "preverify": "node scripts/comprobar-node.mjs"
  },
  "private": true,
  "lint-staged": {
    "servidor/**/*.ts": "npm --prefix servidor exec -- eslint --fix --max-warnings=0",
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.12",
    "npm": ">=11.6 <12"
  }
}
