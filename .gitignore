# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Reportes de cobertura: se generan en cada corrida
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Variables de entorno: ninguna se sube.
# `.env*.local` sola dejaba pasar un `.env` pelado, que es justo donde acaban
# las credenciales del servidor (contraseña de aplicación, clave de cifrado).
.env
.env.*
!.env.example
servidor/.env
servidor/.env.*
!servidor/.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Datos sensibles del spike de captura bancaria (Fase 1)
# Estos volcados contienen movimientos y saldos reales.
capturas/
*.capture.json
