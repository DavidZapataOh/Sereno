# Copiar a .env (que está en .gitignore) y rellenar. Ningún valor va al repositorio.
DATABASE_URL=
# Genera uno: openssl rand -base64 32
SERENO_TOKEN=
# Exactamente 32 bytes: openssl rand -base64 32
SERENO_CLAVE_CIFRADO=
PORT=8080
SERENO_INTERVALO_MINUTOS=10

IMAP_HOST=imap.gmail.com
IMAP_PUERTO=993
IMAP_USUARIO=
# Contraseña de aplicación de Google, nunca la del correo.
IMAP_CLAVE=
IMAP_BUZON=INBOX
# Cuántos días atrás mira la PRIMERA pasada. Después va por UID, incremental.
# No subirlo sin pensarlo: son años de correo personal que hay que barrer.
IMAP_DIAS_INICIALES=30

# Opcional: solo si se usa la API de Gmail en vez de IMAP. Ojo con la trampa
# de los siete días (ver el README del sprint 06).
SERENO_GOOGLE_ID=
SERENO_GOOGLE_SECRET=
SERENO_GMAIL_REFRESH_TOKEN=
